# ─────────────────────────────────────────────────────────────────────────────
# Painel GBP — variáveis de ambiente
#
# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser
# commitado; este arquivo (.env.example) é a única versão versionada e não
# deve conter valor real nenhum.
#
# REGRA CRÍTICA: tudo que começa com NEXT_PUBLIC_ é embutido no bundle e vai
# para o navegador do usuário. Nunca coloque segredo atrás desse prefixo.
# ─────────────────────────────────────────────────────────────────────────────


# ── Banco de dados (Prisma → Supabase Postgres) ──────────────────────────────
# Duas URLs, propósitos diferentes — ver Project Settings → Database:
#
#   DATABASE_URL  runtime da aplicação. Transaction pooler, porta 6543.
#                 Sem isso, cada invocação serverless abre uma conexão nova e
#                 esgota o Postgres.
#   DIRECT_URL    migrations. Conexão direta ou session pooler, porta 5432.
#                 O pooler de transação quebra o DDL do Prisma.
#
# Caracteres especiais na senha precisam ser percent-encoded: @ vira %40,
# # vira %23, / vira %2F.
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"


# ── Supabase Auth ────────────────────────────────────────────────────────────
# Project Settings → API.
# A service role key ignora RLS e tem poder total no banco: só no servidor,
# jamais em Client Component, jamais com prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# ── Aplicação ────────────────────────────────────────────────────────────────
# Base para montar callbacks de OAuth e links em e-mail/PDF.
# Local: http://localhost:3000 · Produção: https://seudominio.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chave de criptografia dos tokens OAuth do Google (AES-256-GCM).
# Gere com:  openssl rand -base64 32
# Trocar esta chave torna ilegível todo token já gravado — os usuários
# precisariam reconectar. Guarde no gerenciador de segredos.
ENCRYPTION_KEY=""

# Protege os endpoints de cron. Qualquer string longa e aleatória.
# Gere com:  openssl rand -hex 32
CRON_SECRET=""


# ── Google Business Profile (OAuth) ──────────────────────────────────────────
# Google Cloud Console → APIs e Serviços → Credenciais → ID do cliente OAuth.
# O redirect URI precisa estar cadastrado lá exatamente igual ao valor abaixo.
# Lembre que as Business Profile APIs vêm com cota 0 até o allowlist ser
# aprovado (7–10 dias úteis, por projeto do Cloud) e que a API v4, usada em
# avaliações e postagens, tem allowlist próprio.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"


# ── Places API (concorrentes) ────────────────────────────────────────────────
# Pode ser a mesma chave do projeto Google, restrita à Places API (New).
# Exige billing ativo no Google Cloud mesmo dentro da cota grátis.
GOOGLE_PLACES_API_KEY=""


# ── SerpApi (rank tracking e análise de mercado) ─────────────────────────────
# Cota grátis: 100 buscas/mês. Um grid 5x5 consome 25 de uma vez.
SERPAPI_KEY=""


# ── Google Ads (volume de busca — Keyword Planner) ───────────────────────────
# Substitui o DataForSEO como fonte de volume: é o dado de origem, e a
# precisão depende da conta usada — contas com investimento ativo recebem a
# média mensal fechada, contas sem gasto recebem faixas largas ("1 mil – 10
# mil"). Use a conta que de fato investe.
#
# O developer token sai de Ferramentas → Central de API, na conta MCC, e
# precisa de aprovação para acesso básico: com token em nível de teste a API
# responde só sobre contas de teste, sem dado real.
#
# O refresh token é da conta de Ads, com escopo
# https://www.googleapis.com/auth/adwords — separado do OAuth do Business
# Profile, que tem escopo e dono diferentes. Gere com o OAuth Playground
# usando o mesmo GOOGLE_CLIENT_ID/SECRET.
#
# CUSTOMER_ID é a conta que será consultada (só dígitos, sem hífen).
# LOGIN_CUSTOMER_ID só é necessário quando ela é gerenciada por uma MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_REFRESH_TOKEN=""


# ── Fonte do volume de busca ─────────────────────────────────────────────────
# Qual provedor usar: "google-ads" ou "mangools".
# Em branco, usa o Google Ads quando estiver configurado e cai no Mangools.
#
# O Google Ads é o destino: é o dado de origem e a única fonte que abre a
# média mensal fechada para contas com investimento ativo. O Mangools serve de
# ponte enquanto o developer token não é aprovado — exige só uma chave, sem
# MCC e sem espera, mas revende o número público do Keyword Planner, que vem
# arredondado.
VOLUME_PROVIDER=""

# mangools.com/api-token (a chave existe mesmo no plano gratuito; o que varia
# entre planos é o limite de keyword lookups).
MANGOOLS_API_TOKEN=""

# Alvo geográfico e idioma, nos identificadores do Google — as duas fontes
# usam os mesmos. Padrão: 2076 (Brasil) e 1014 (português).
VOLUME_LOCATION_ID=""
VOLUME_LANGUAGE_ID=""


# ── Anthropic (respostas de avaliação, recomendações, keywords, posts) ───────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""


# ── Stripe (billing) ─────────────────────────────────────────────────────────
# Use as chaves de teste (sk_test_ / pk_test_) em desenvolvimento.
# O webhook secret sai de `stripe listen` no local e do dashboard em produção.
# Os price ids não entram aqui: ficam em Plan.stripePriceId no banco.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""


# ── Resend (e-mail transacional: convite de equipe e alerta crítico) ─────────
# resend.com → API Keys. Sem esta chave o app roda normalmente: o convite
# continua válido (o link aparece na tela para copiar) e o alerta continua na
# central — só o e-mail não sai.
# EMAIL_FROM precisa ser de um domínio verificado no Resend; o valor padrão
# (onboarding@resend.dev) só entrega para o e-mail dono da conta Resend.
RESEND_API_KEY=""
EMAIL_FROM="Painel GBP <onboarding@resend.dev>"

# ── Sentry (observabilidade) ─────────────────────────────────────────────────
# Opcional: sem DSN o SDK nem é inicializado e o app roda igual. O DSN é
# público por natureza — só permite enviar evento, não ler.
#
# SENTRY_DSN            servidor (Server Components, rotas, jobs)
# NEXT_PUBLIC_SENTRY_DSN navegador — vai para o bundle, use o mesmo valor
# SENTRY_AUTH_TOKEN     só no build de produção, para enviar source maps.
#                       Sem ele o build funciona e os stack traces ficam
#                       ofuscados.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── DataForSEO (volume de busca — fonte paga) ────────────────────────────────
# Terceira opção, para quando o Google Ads está travado na aprovação do
# developer token. O número vem do Keyword Planner consultado pelas contas de
# Ads do próprio DataForSEO, então costuma vir fechado — mas é revenda e é
# pago por consulta.
#
# O painel deles mostra as duas formas: o par login/senha de API, ou o valor
# Base64 pronto do header Authorization. Preencha UMA delas.
# Atenção: a senha de API não é a senha de login da conta.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
DATAFORSEO_AUTH=""
