# ─────────────────────────────────────────────────────────────────────────────
# Painel GBP — variáveis de ambiente
#
# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser
# commitado; este arquivo (.env.example) é a única versão versionada e não
# deve conter valor real nenhum.
#
# REGRA CRÍTICA: tudo que começa com NEXT_PUBLIC_ é embutido no bundle e vai
# para o navegador do usuário. Nunca coloque segredo atrás desse prefixo.
# ─────────────────────────────────────────────────────────────────────────────


# ── Banco de dados (Prisma → Supabase Postgres) ──────────────────────────────
# Duas URLs, propósitos diferentes — ver Project Settings → Database:
#
#   DATABASE_URL  runtime da aplicação. Transaction pooler, porta 6543.
#                 Sem isso, cada invocação serverless abre uma conexão nova e
#                 esgota o Postgres.
#   DIRECT_URL    migrations. Conexão direta ou session pooler, porta 5432.
#                 O pooler de transação quebra o DDL do Prisma.
#
# Caracteres especiais na senha precisam ser percent-encoded: @ vira %40,
# # vira %23, / vira %2F.
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"


# ── Supabase Auth ────────────────────────────────────────────────────────────
# Project Settings → API.
# A service role key ignora RLS e tem poder total no banco: só no servidor,
# jamais em Client Component, jamais com prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# ── Aplicação ────────────────────────────────────────────────────────────────
# Base para montar callbacks de OAuth e links em e-mail/PDF.
# Local: http://localhost:3000 · Produção: https://seudominio.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chave de criptografia dos tokens OAuth do Google (AES-256-GCM).
# Gere com:  openssl rand -base64 32
# Trocar esta chave torna ilegível todo token já gravado — os usuários
# precisariam reconectar. Guarde no gerenciador de segredos.
ENCRYPTION_KEY=""

# Protege os endpoints de cron. Qualquer string longa e aleatória.
# Gere com:  openssl rand -hex 32
CRON_SECRET=""


# ── Google Business Profile (OAuth) ──────────────────────────────────────────
# Google Cloud Console → APIs e Serviços → Credenciais → ID do cliente OAuth.
# O redirect URI precisa estar cadastrado lá exatamente igual ao valor abaixo.
# Lembre que as Business Profile APIs vêm com cota 0 até o allowlist ser
# aprovado (7–10 dias úteis, por projeto do Cloud) e que a API v4, usada em
# avaliações e postagens, tem allowlist próprio.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"


# ── Places API (concorrentes) ────────────────────────────────────────────────
# Pode ser a mesma chave do projeto Google, restrita à Places API (New).
# Exige billing ativo no Google Cloud mesmo dentro da cota grátis.
GOOGLE_PLACES_API_KEY=""


# ── SerpApi (rank tracking e análise de mercado) ─────────────────────────────
# Cota grátis: 100 buscas/mês. Um grid 5x5 consome 25 de uma vez.
SERPAPI_KEY=""


# ── DataForSEO (volume de busca) ─────────────────────────────────────────────
# Autenticação é login + senha da conta, não uma API key.
# Exige billing ativo — o sandbox também fica bloqueado sem isso.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""


# ── Anthropic (respostas de avaliação, recomendações, keywords, posts) ───────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""


# ── Stripe (billing) ─────────────────────────────────────────────────────────
# Use as chaves de teste (sk_test_ / pk_test_) em desenvolvimento.
# O webhook secret sai de `stripe listen` no local e do dashboard em produção.
# Os price ids não entram aqui: ficam em Plan.stripePriceId no banco.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
