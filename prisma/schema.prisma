// ─────────────────────────────────────────────────────────────────────────────
// Painel GBP — schema inicial (V1)
// Ver PRD-gbp-dashboard.md para o racional de cada bloco.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

// No Prisma 7 as URLs saem do schema:
//   migrations  -> prisma.config.ts (conexão direta, 5432)
//   runtime     -> driver adapter em src/lib/prisma.ts (pooler, 6543)
datasource db {
  provider = "postgresql"
}

// ── Conta / usuários ────────────────────────────────────────────────────────

model Account {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String // nome da agência ou do negócio dono da conta
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members           AccountMember[]
  invites           Invite[]
  googleConnections GoogleConnection[]
  businesses        Business[]
  marketScans       MarketScan[]
  subscription      Subscription?

  @@map("accounts")
}

enum AccountRole {
  OWNER
  MEMBER
}

model AccountMember {
  id        String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AccountRole @default(OWNER)
  createdAt DateTime    @default(now())

  @@unique([accountId, userId])
  @@index([userId])
  @@map("account_members")
}

/// Convite de membro para uma conta.
///
/// O `token` é o segredo enviado por e-mail — é ele que autoriza o aceite,
/// então tem índice único e prazo de validade. Convite aceito guarda
/// `acceptedAt` em vez de ser apagado: sem esse registro não dá para auditar
/// quem entrou na conta e por qual convite.
model Invite {
  id         String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email      String
  role       AccountRole @default(MEMBER)
  token      String      @unique
  invitedBy  String? // userId de quem convidou
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([accountId])
  @@index([email])
  @@map("invites")
}

model User {
  id        String   @id // id do Supabase Auth
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  memberships       AccountMember[]
  googleConnections GoogleConnection[] // quem de fato clicou "conectar" (auditoria)
  notificationPrefs NotificationPreference[]

  @@map("users")
}

// ── Conexão com o Google ───────────────────────────────────────────────────

enum GoogleConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model GoogleConnection {
  id                 String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId          String
  account            Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  connectedByUserId  String
  connectedByUser    User                   @relation(fields: [connectedByUserId], references: [id])
  googleAccountEmail String?
  accessToken        String?                @db.Text // criptografado na aplicação
  refreshToken       String?                @db.Text // criptografado na aplicação
  tokenExpiry        DateTime?
  scopes             String?
  status             GoogleConnectionStatus @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt

  businesses Business[]

  @@index([accountId])
  @@map("google_connections")
}

// ── Negócio (Perfil de Empresa rastreado) ──────────────────────────────────

enum BusinessStatus {
  ACTIVE
  PAUSED
  DISCONNECTED
}

model Business {
  id                 String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId          String
  account            Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  googleConnectionId String
  googleConnection   GoogleConnection @relation(fields: [googleConnectionId], references: [id])

  // identificação no Google
  gbpAccountName String? // resource name da conta GBP (accounts/123)
  locationName   String  @unique // resource name do local (locations/456)
  placeId        String?

  // dados do perfil (cache — origem de verdade é o Google; sincronizado periodicamente)
  title                String
  primaryCategory      String?
  primaryCategoryGcid  String? // id interno da categoria (para editar/comparar)
  additionalCategories String[]
  description          String?  @db.Text
  phone                String?
  website              String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  countryCode          String   @default("BR")
  lat                  Float?
  lng                  Float?

  // configuração usada nas métricas estimadas (5.9 do PRD)
  ticketMedio         Float?
  taxaConversaoManual Float? // 0-1; se nulo, usa SegmentBenchmark pela categoria

  // tom das gerações de IA (5.4 do PRD); nulo = tom padrão do prompt
  tomDeVoz String? @db.Text

  status       BusinessStatus @default(ACTIVE)
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  performanceDaily PerformanceDaily[]
  syncRuns         SyncRun[]
  reviews          Review[]
  auditSnapshots   AuditSnapshot[]
  competitors      Competitor[]
  keywords         Keyword[]
  posts            Post[]
  checklistItems   ChecklistItem[]
  alerts           Alert[]
  reports          Report[]

  @@index([accountId])
  @@map("businesses")
}

// ── Desempenho (série diária — Performance API) ────────────────────────────

model PerformanceDaily {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  viewsSearch       Int @default(0)
  viewsMaps         Int @default(0)
  calls             Int @default(0)
  websiteClicks     Int @default(0)
  directionRequests Int @default(0)
  conversations     Int @default(0)
  bookings          Int @default(0)

  syncedAt DateTime @default(now())

  @@unique([businessId, date])
  @@index([businessId, date])
  @@map("performance_daily")
}

// ── Avaliações ──────────────────────────────────────────────────────────────

model Review {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gbpReviewId      String // id da avaliação na API v4
  reviewerName     String?
  reviewerPhotoUrl String?
  starRating       Int?
  comment          String?  @db.Text

  replyText    String?   @db.Text // resposta efetivamente publicada
  repliedAt    DateTime?
  aiDraftReply String?   @db.Text // último rascunho gerado por IA (antes de publicar)

  createTime DateTime?
  updateTime DateTime?
  syncedAt   DateTime  @default(now())

  @@unique([businessId, gbpReviewId])
  @@index([businessId])
  @@map("reviews")
}

// ── Auditoria (nota + checklist, histórico) ────────────────────────────────

model AuditSnapshot {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  score      Int // 0-100
  checksJson Json // array de { label, status, dica } no momento da auditoria
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_snapshots")
}

// ── Concorrentes ────────────────────────────────────────────────────────────

model Competitor {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  placeId    String?
  name       String
  category   String?
  address    String?
  createdAt  DateTime @default(now())

  snapshots CompetitorSnapshot[]

  @@index([businessId])
  @@map("competitors")
}

model CompetitorSnapshot {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  rating       Float?
  reviewCount  Int?
  hasWebsite   Boolean?
  hasHours     Boolean?
  capturedAt   DateTime   @default(now())

  @@index([competitorId, capturedAt])
  @@map("competitor_snapshots")
}

// ── Palavras-chave e Rank Tracking ──────────────────────────────────────────

model Keyword {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  term           String
  volume         Int? // buscas/mês (DataForSEO), cache mensal
  volumeSyncedAt DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  rankChecks RankCheck[]

  @@unique([businessId, term])
  @@index([businessId])
  @@map("keywords")
}

enum RankCheckType {
  SINGLE
  GRID
}

model RankCheck {
  id          String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  keywordId   String
  keyword     Keyword       @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  type        RankCheckType
  gridSize    Int? // 3, 5... (nulo se SINGLE)
  centerLat   Float
  centerLng   Float
  myPosition  Int? // nulo = não apareceu no top consultado
  avgPosition Float?
  coverage    Int? // em quantos pontos apareceu (GRID) — 1 para SINGLE
  totalPoints Int
  createdAt   DateTime      @default(now())

  points RankCheckPoint[]

  @@index([keywordId, createdAt])
  @@map("rank_checks")
}

model RankCheckPoint {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  rankCheckId String
  rankCheck   RankCheck @relation(fields: [rankCheckId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  position    Int? // posição do negócio rastreado nesse ponto (nulo = fora do top)
  resultsJson Json // ranking completo retornado pelo SerpApi nesse ponto (top N)

  @@index([rankCheckId])
  @@map("rank_check_points")
}

// Análise ad-hoc de QUALQUER negócio (não precisa ser um Business rastreado) —
// usado para prospecção/CRM pela agência. Ver seção 9 do PRD.
model MarketScan {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  queryName    String // nome digitado na busca
  businessName String // negócio selecionado
  placeId      String?
  keyword      String
  position     Int?
  resultJson   Json // ranking completo retornado
  createdAt    DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("market_scans")
}

// ── Postagens (Google Posts) ────────────────────────────────────────────────

enum PostType {
  STANDARD
  EVENT
  OFFER
}

enum PostState {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model Post {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gbpPostId    String? // preenchido após publicar
  summary      String    @db.Text
  postType     PostType  @default(STANDARD)
  state        PostState @default(DRAFT)
  mediaUrl     String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([businessId, state])
  @@map("posts")
}

// ── Checklist e Alertas ──────────────────────────────────────────────────────

enum ChecklistStatus {
  OPEN
  DONE
  DISMISSED
}

model ChecklistItem {
  id          String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  area        String // ex: Avaliações, Categorias, Descrição, Fotos, Postagens
  priority    String // alta | media | baixa
  title       String
  description String?         @db.Text
  status      ChecklistStatus @default(OPEN)
  generatedAt DateTime        @default(now())
  resolvedAt  DateTime?

  @@index([businessId, status])
  @@map("checklist_items")
}

enum AlertType {
  NEW_REVIEW
  LOW_RATING_REVIEW
  RATING_DROP
  NO_ACTIVITY
  SYNC_FAILED
  RANK_DROP
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id         String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       AlertType
  severity   AlertSeverity @default(INFO)
  message    String
  metaJson   Json?
  readAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([businessId, readAt])
  @@map("alerts")
}

/// Preferência de notificação por e-mail.
///
/// A preferência é do usuário, não da conta: quem recebe é uma pessoa, e a
/// mesma pessoa em duas contas não quer regras diferentes para a própria
/// caixa de entrada. Sem linha aqui vale o padrão — todo OWNER recebe alerta
/// CRITICAL —, então a tabela só guarda quem mudou o padrão.
model NotificationPreference {
  id                   String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOnCriticalAlert Boolean  @default(true)
  updatedAt            DateTime @default(now()) @updatedAt

  @@map("notification_preferences")
}

// ── Benchmarks para métricas estimadas ───────────────────────────────────────

model SegmentBenchmark {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  category          String   @unique // ex: "Clínica de estética", "Restaurante"
  avgConversionRate Float // 0-1, referência do segmento (5.9 do PRD)
  avgTicket         Float // R$, fallback se o negócio não configurar o próprio
  source            String? // de onde veio o número (nota de transparência)
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("segment_benchmarks")
}

// ── Relatórios ────────────────────────────────────────────────────────────

model Report {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  format      String // pdf | csv
  fileUrl     String
  generatedAt DateTime @default(now())

  @@index([businessId])
  @@map("reports")
}

// ── Execução de jobs ──────────────────────────────────────────────────────

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

/// Registro de execução de job.
///
/// Existe para que a falha de um sync seja auditável dentro do produto, sem
/// depender do log da plataforma de deploy — que expira, não é consultável por
/// negócio e não sobrevive a uma troca de host.
///
/// `businessId` é opcional porque há jobs que rodam para a instalação inteira
/// (a varredura que enfileira os negócios), não para um negócio específico.
model SyncRun {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId     String?
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobType        String // sync-diario | snapshot-concorrentes | publicar-agendados
  status         SyncRunStatus @default(RUNNING)
  itemsProcessed Int           @default(0)
  errorMessage   String?       @db.Text
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([businessId, startedAt])
  @@index([jobType, startedAt])
  @@map("sync_runs")
}

// ── Billing ──────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  AGENCY
}

model Plan {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tier          PlanTier @unique
  name          String
  priceCents    Int
  maxBusinesses Int
  maxKeywords   Int
  stripePriceId String?

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId            String             @unique
  account              Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  /// Cancelamento agendado para o fim do período já pago. O acesso continua
  /// até `currentPeriodEnd` — cortar na hora seria cobrar por tempo não usado.
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

/// Consumo registrado para rate limiting (E10-05).
///
/// Uma linha por chamada a API paga, com a chave identificando conta+recurso.
/// Contador em memória não serve: cada invocação serverless tem a própria
/// memória, então o limite seria multiplicado pelo número de instâncias quentes
/// — exatamente o cenário de um loop queimando a cota mensal do SerpApi.
model RateLimitHit {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  chave     String // "<recurso>:<accountId>"
  createdAt DateTime @default(now())

  @@index([chave, createdAt])
  @@map("rate_limit_hits")
}

/// Eventos do Stripe já processados (idempotência do webhook — E9-04).
///
/// O Stripe reentrega evento sempre que a resposta demora ou falha, e a mesma
/// entrega pode chegar duas vezes em paralelo. A chave primária é o próprio id
/// do evento: gravar antes de processar transforma "já vi isto?" em uma
/// violação de unicidade, que é atômica — diferente de um SELECT seguido de
/// INSERT, onde as duas entregas podem passar juntas pela checagem.
model StripeEvent {
  id          String   @id // evt_... vindo do Stripe
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}
